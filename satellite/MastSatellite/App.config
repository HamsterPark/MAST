<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    useLegacyV2RuntimeActivationPolicy mirrors the app.config of the LightField
    C# automation sample (Add-in and Automation SDK, Automation sample project).
  -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.net>
    <!-- Never route the hub link through a system proxy. -->
    <defaultProxy enabled="false" />
  </system.net>
  <!--
    The satellite PC may have two monitors running at different scaling. With this, WinForms resizes the
    window and raises DpiChanged when it moves between them (the section is declared in
    machine.config since .NET 4.7; app.manifest already declares PerMonitorV2).
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
